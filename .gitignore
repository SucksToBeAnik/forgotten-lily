# Generated audio (rebuilt from scripts: tones/synth.py and tones/ambient.py)
# `**` so the demo/ subdirectory (synth.py --demo) is covered too — HF Spaces
# rejects binary files in git; these are regenerable build output.
app/static/tones/**/*.wav
app/static/tones/*.wav
app/static/audio/*.wav
# ...except Lily's pre-rendered spoken line for the ending — it can't be regenerated
# from a script on the Space (it's TTS), so it must ship in the repo (via Git-LFS).
!app/static/audio/final_words.wav

# Model weights / large assets (live on Modal Volume, not in git)
*.gguf
*.safetensors
*.bin
models/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.env

# OS / editor
.DS_Store
*.swp

# Modal local cache
.modal/

# Local Claude Code harness state
.claude/
